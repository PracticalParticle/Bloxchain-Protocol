{
  "name": "@bloxchain/contracts",
  "version": "1.1.0",
  "description": "Library engine for building enterprise grade decentralized permissioned applications",
  "files": [
    "core",
    "abi",
    "artifacts",
    "standards",
    "components",
    "official-deployed-addresses.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./artifacts/manifest.json": "./artifacts/manifest.json",
    "./artifacts/*.json": "./artifacts/*.json",
    "./artifacts/*": "./artifacts/*.json",
    "./official-deployed-addresses.json": "./official-deployed-addresses.json",
    "./abi/*.json": "./abi/*.json",
    "./abi/*": "./abi/*.json",
    "./core/*": "./core/*",
    "./standards/*": "./standards/*",
    "./components/*": "./components/*",
    "./*": "./*"
  },
  "scripts": {
    "prepublishOnly": "node scripts/prepublish-contracts.cjs",
    "postpublish": "node scripts/postpublish-contracts.cjs",
    "prepare:deps": "npm install"
  },
  "keywords": [
    "bloxchain",
    "solidity",
    "ethereum",
    "smart-contracts",
    "state-abstraction",
    "security",
    "multi-signature",
    "rbac",
    "secure-ownership"
  ],
  "author": "Particle Crypto Security",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PracticalParticle/Bloxchain-Protocol.git",
    "directory": "package"
  },
  "homepage": "https://bloxchain.app/",
  "bugs": {
    "url": "https://github.com/PracticalParticle/Bloxchain-Protocol/issues",
    "email": "security@particlecs.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1"
  },
  "engines": {
    "node": ">=18.20.5"
  }
}
