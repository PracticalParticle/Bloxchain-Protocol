{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "package": {
      "release-type": "node",
      "package-name": "@bloxchain/contracts",
      "version-file": "package/package.json",
      "changelog-path": "package/CHANGELOG.md"
    },
    "sdk/typescript": {
      "release-type": "node",
      "package-name": "@bloxchain/sdk",
      "version-file": "sdk/typescript/package.json",
      "changelog-path": "sdk/typescript/CHANGELOG.md"
    }
  },
  "$comment": "Independent semver per publishable package. Root package.json is not release-managed."
}
